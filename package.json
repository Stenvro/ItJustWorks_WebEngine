{
  "name": "itjustworks-webengine",
  "private": true,
  "description": "A browser engine for The Elder Scrolls V: Skyrim Special Edition: TypeScript and WebGPU, reading the game from your own installation.",
  "keywords": [
    "skyrim",
    "tes5",
    "game-engine",
    "webgpu",
    "typescript",
    "reimplementation"
  ],
  "license": "GPL-3.0-or-later",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.portable.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:gamefiles": "node tools/check-no-gamefiles.ts --all",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run check:gamefiles",
    "prepare": "node tools/install-hooks.ts",
    "check:history": "node tools/check-no-gamefiles.ts --history"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@webgpu/types": "^0.1.74",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@ffmpeg/core": "0.12.10",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0"
  }
}
