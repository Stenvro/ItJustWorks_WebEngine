{
  // Platform-independent code (parsers, the VFS core, the Papyrus VM, collision data and the
  // gameplay models): no DOM and no Node types.
  // If that code accidentally uses a browser or Node API, `npm run typecheck` fails.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2024"],
    "types": []
  },
  "include": [
    "src/formats",
    "src/vfs",
    "src/scripting",
    "src/physics/collision-data.ts",
    "src/physics/collision-layers.ts",
    "src/animation",
    "src/audio/xwma-decoder.ts",
    "src/gameplay",
    "src/world/crafting-records.ts"
  ],
  "exclude": ["src/**/*.test.ts", "src/vfs/browser"]
}
