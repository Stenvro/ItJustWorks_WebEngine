{
  // Platform-independent code (parsers and the VFS core): no DOM and no Node types.
  // If that code accidentally uses a browser or Node API, `npm run typecheck` fails.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2024"],
    "types": []
  },
  "include": ["src/formats", "src/vfs"],
  "exclude": ["src/**/*.test.ts", "src/vfs/browser"]
}
