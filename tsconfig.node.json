{
  // Node side: CLIs in tools/, tests and config files.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2024"],
    "types": ["node"]
  },
  "include": ["tools", "tests", "src/**/*.test.ts", "vite.config.ts"],
  // The simulation's tests and tools: tsconfig.sim.json.
  "exclude": ["tests/helpers/sim.ts", "tests/sim-*.ts", "tests/conformance", "tools/sim-*.ts"]
}
